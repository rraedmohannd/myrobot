# Settings of robotd and visiond on the Raspberry Pi. Copied once to
# /etc/smart-campus-robot/robot.env by robot/deploy/setup.sh. No secrets in git:
# ROBOT_TOKEN is typed here on the Pi only (the same value as in the backend's .env).

# The laptop that runs the backend (docs/DEPLOY.md: fixed address, firewall rule for port 8000).
# One address, or several separated by commas (no spaces), tried in order until one connects;
# e.g. the laptop's Windows "Mobile hotspot" address first, then its address on the demo site's
# network. Do not put ?token= here: robotd adds ROBOT_TOKEN to every address itself.
# The addresses below are examples; use the laptop's real ones.
BACKEND_URL=ws://192.168.137.1:8000/ws/robot,ws://192.168.1.10:8000/ws/robot
ROBOT_TOKEN=

# Server mode (backend on a rented server, docs/DEPLOY.md "Server mode"): use wss:// and the
# server's domain, no port; the laptop may follow as a fallback. ROBOT_TOKEN is then the value
# from the server's deploy/server/.env. The certificate is always verified (system CA store).
# BACKEND_URL=wss://<domain>/ws/robot,ws://192.168.137.1:8000/ws/robot
# Only for a test CA or a self-hosted CA (never with Let's Encrypt): a CA bundle that REPLACES
# the system store for the backend connections.
# BACKEND_CA_FILE=/etc/smart-campus-robot/test-ca.pem

# ESP32 serial port: the udev rule gives it a stable name
ROBOTD_SERIAL_PORT=/dev/esp32

# Local page for the screen (Chromium kiosk opens http://localhost:8765)
ROBOTD_UI_PORT=8765

# Camera of visiond: a device index (USB webcam) or a URL (phone, for development)
CAMERA_SOURCE=0
