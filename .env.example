# Copy to .env (copy .env.example .env) and edit. Never commit .env.

# --- Database (used by docker-compose) ---
POSTGRES_USER=robot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smart_campus
# Used when running the backend outside Docker. Inside Docker, docker-compose overrides it.
DATABASE_URL=postgresql+asyncpg://robot:change-me@localhost:5433/smart_campus

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
# Password for the review page http://localhost:8000/admin (pick your own, keep it private)
ADMIN_TOKEN=change-me-admin

# Time zone used for "today" in the admin analytics
LOCAL_TIMEZONE=Asia/Amman

# --- AI providers (B3+) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Model ids: run `docker compose exec backend python -m app.ingestion.cli check-openai` to see what your key can use
LLM_MODEL=gpt-6-luna
# Reasoning effort for reasoning models: low / medium / high. "low" is the tested default
# (2026-11-13: 10/10 on the bench questions, faster answers). Empty = the model's own default.
LLM_REASONING_EFFORT=low
# Speak the answer sentence by sentence while the model is still writing (false = wait for the whole answer)
LLM_STREAMING=true
EMBEDDING_MODEL=text-embedding-3-small
# --- Speech (B4) ---
STT_MODEL=gpt-transcribe
TTS_MODEL=gpt-4o-mini-tts
# Listen to `python -m app.ingestion.cli tts-samples` (or the /voice page) and pick the best Jordanian accent
TTS_VOICE=coral
# Speaking pace (sprint 2). TTS_SPEED: the provider's speed (1.0 = normal, 1.12 = a little faster).
# After changing the voice, the speed or TTS_INSTRUCTIONS run:
#   docker compose exec backend python -m app.ingestion.cli prepare-phrases
TTS_SPEED=1.12
# Extra playback rate applied by the browser / robot with the pitch kept. Leave 1.0 while TTS_SPEED is used.
SPEECH_RATE=1.0
# The first spoken piece of an answer is cut after about this many words (its audio is ready sooner)
TTS_FIRST_PIECE_WORDS=6
# Experimental: send answer speech as PCM chunks while it is generated. Off by default: the
# measurements of 2026-11-13 did not show a reliable gain (docs/DECISIONS.md).
TTS_STREAMING=false
# Silence (ms) that ends the visitor's utterance. 700 is faster; use 900 if the robot cuts you off mid-sentence
VAD_SILENCE_MS=700
FOLLOW_UP_TIMEOUT_S=10
# Optional: require ?token=... on /ws/robot (set the same value on the Raspberry Pi)
ROBOT_TOKEN=

# --- Sprint 3: local network, resilience, privacy (see docs/DEPLOY.md and docs/PRIVACY.md) ---
# Address other devices use to reach this backend (for the QR on the admin page), e.g. http://192.168.1.20:8000
PUBLIC_BASE_URL=
# Networks that may connect to /ws/robot without ROBOT_TOKEN (default: this machine only)
ROBOT_LOCAL_NETS=127.0.0.1/32,::1/128
# Robot status and command requests
ROBOT_OFFLINE_AFTER_S=5
ROBOT_COMMAND_TIMEOUT_S=5
# An approved FAQ answers when the question is this similar (0.88 from a small calibration)
FAQ_MATCH_THRESHOLD=0.88
# Time limits (seconds), retries and circuit breaker for every provider call
PROVIDER_TIMEOUT_EMBEDDING_S=6
PROVIDER_TIMEOUT_STT_S=12
PROVIDER_TIMEOUT_LLM_FIRST_S=10
PROVIDER_TIMEOUT_LLM_S=25
PROVIDER_TIMEOUT_TTS_S=12
PROVIDER_RETRIES=1
BREAKER_FAILURES=3
BREAKER_OPEN_S=30
# Official faculty page for the "weak internet" QR (empty = the approved faculty page in the sources table)
FACULTY_PAGE_URL=
# Conversations (text only) are deleted by `purge-conversations` after this many days
CONVERSATION_RETENTION_DAYS=30
# Admin login sessions end after this many hours
ADMIN_SESSION_HOURS=12
