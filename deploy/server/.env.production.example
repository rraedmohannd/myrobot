# Production settings of the Smart Campus Robot backend (server mode).
#
# install.sh copies this file to deploy/server/.env (mode 600, git-ignored) and replaces:
#   __GENERATE__        a new random secret (openssl rand; letters and digits only, so it is safe
#                       inside the database URL and in shell scripts)
#   __DOMAIN__          the domain, or <ip-with-dashes>.sslip.io when there is none
#   __OPENAI_API_KEY__  the OpenAI key typed in by Mohannd (hidden input; never echoed or logged)
# Never commit deploy/server/.env, never send it by chat, never copy the laptop's .env here.
# After editing deploy/server/.env by hand, apply it with: sudo bash deploy/server/update.sh
# (or: sudo bash -c 'source deploy/server/lib.sh && dc up -d').

# --- Mode ---
# production switches on every check of docs/SPRINT_6.md P0.2 (the backend refuses weak secrets).
APP_ENV=production
LOG_LEVEL=INFO

# --- Address ---
# The name the robot and the browsers use. Empty -> install.sh sets <ip-with-dashes>.sslip.io.
DOMAIN=__DOMAIN__
# Must start with https:// ; CORS is limited to it and the admin QR codes point to it.
PUBLIC_BASE_URL=https://__DOMAIN__
CORS_ORIGINS=https://__DOMAIN__

# --- Database (container "db", never published on a port) ---
POSTGRES_USER=robot
# At least 16 characters. Letters and digits only (it is put into the database URL).
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=smart_campus

# --- Secrets ---
# At least 32 characters. Only used by scripts when ADMIN_TOKEN_SCRIPTS=true; people log in
# with a user name and password (deploy/server/create-admin.sh).
ADMIN_TOKEN=__GENERATE__
# true = the X-Admin-Token header is accepted (scripts). Keep false.
ADMIN_TOKEN_SCRIPTS=false
# Required. The robot (Pi) sends it on /ws/robot; set the same value in the robot's robot.env.
ROBOT_TOKEN=__GENERATE__
# At least 32 characters. Signs the visitor cookies. Changing it logs every visitor out.
SECRET_KEY=__GENERATE__

# --- Public pages (/robot, /voice, the chat) ---
# true = visitors can use the pages after typing the access code once (a signed cookie remembers
# it for VISITOR_SESSION_HOURS). Never turn the code off: the pages spend the OpenAI credit.
PUBLIC_PAGES=true
# Required when PUBLIC_PAGES=true. Give it only to the people at the demo.
SITE_ACCESS_CODE=__GENERATE__
VISITOR_SESSION_HOURS=12
ADMIN_SESSION_HOURS=12

# --- Cost guard ---
# Paid OpenAI calls per day for the whole server (questions, speech-to-text, text-to-speech).
# Over it the robot gives its polite offline reply and the admin page shows a warning.
DAILY_PAID_CALL_LIMIT=500
# Paid calls per minute per visitor IP address
RATE_LIMIT_PAID_PER_MIN=12
# Paid calls per minute per IP address that sends the robot token
RATE_LIMIT_ROBOT_PER_MIN=60
# Admin login: lock an account/IP for LOGIN_LOCKOUT_MIN minutes after this many failures
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MIN=15
# Largest media upload in the admin page (MB). The proxy allows 60 MB.
MEDIA_MAX_MB=50

# --- Web server ---
# Uvicorn trusts X-Forwarded-For/Proto only from these addresses: Caddy (172.31.240.10) and the
# Docker bridge gateway (172.31.240.1 = a host nginx in "behind an existing web server" mode).
FORWARDED_ALLOW_IPS=172.31.240.10,172.31.240.1
# Keep 1: the live robot link, the rate limiters and the login lockout live in the process;
# several workers would each keep their own copy.
WEB_CONCURRENCY=1

# --- Caddy (HTTPS) ---
# true  = Caddy in front, on ports 80 and 443, with automatic certificates (default).
# false = a web server already on this machine (nginx); the backend listens on BACKEND_BIND only.
#         See deploy/server/nginx-site.conf.example.
USE_CADDY=true
HTTP_PORT=80
HTTPS_PORT=443
# Empty = automatic Let's Encrypt certificate. "internal" = Caddy's own CA (laptop rehearsal only).
CADDY_TLS=
# Optional contact address for certificate expiry notices
ACME_EMAIL=
# nginx mode only (USE_CADDY=false): keep it on 127.0.0.1
BACKEND_BIND=127.0.0.1:8000

# --- Backend image ---
# Empty = built on this server from the code (smart-campus-backend:local). With the GitHub image:
# ghcr.io/<owner>/smart-campus-backend:<tag> (update.sh --image).
BACKEND_IMAGE=

# --- Backups (service "backup"; times are UTC) ---
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
# Conversations (text only) older than this are deleted by purge-conversations
CONVERSATION_RETENTION_DAYS=30
LOCAL_TIMEZONE=Asia/Amman

# --- Robot ---
# Networks that may use /ws/robot without ROBOT_TOKEN. Empty: on a server every robot needs it.
ROBOT_LOCAL_NETS=
ROBOT_OFFLINE_AFTER_S=5
ROBOT_COMMAND_TIMEOUT_S=5

# --- Simulation ---
# true = deterministic FAKE speech-to-text / answers / speech / embeddings, logged as SIMULATED.
# Laptop rehearsal only; never on the real server.
FAKE_PROVIDERS=false

# --- AI providers ---
# A separate OpenAI key for this server, with a monthly spending limit (made by Mohannd).
OPENAI_API_KEY=__OPENAI_API_KEY__
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=low
LLM_STREAMING=true
EMBEDDING_MODEL=text-embedding-3-small
STT_MODEL=gpt-transcribe
# openai | openai_realtime | elevenlabs (see .env.example and docs/PLAN.md)
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_REALTIME_MODEL=gpt-realtime-2.1-mini
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
TTS_VOICE=coral
TTS_SPEED=1.12
SPEECH_RATE=1.0
TTS_FIRST_PIECE_WORDS=6
TTS_STREAMING=false
VAD_SILENCE_MS=700
FOLLOW_UP_TIMEOUT_S=10
FAQ_MATCH_THRESHOLD=0.88

# --- Provider time limits, retries, circuit breaker ---
PROVIDER_TIMEOUT_EMBEDDING_S=6
PROVIDER_TIMEOUT_STT_S=12
PROVIDER_TIMEOUT_LLM_FIRST_S=10
PROVIDER_TIMEOUT_LLM_S=25
PROVIDER_TIMEOUT_TTS_S=12
PROVIDER_RETRIES=1
BREAKER_FAILURES=3
BREAKER_OPEN_S=30
# Official faculty page for the "weak internet" QR (empty = the approved faculty page in the DB)
FACULTY_PAGE_URL=
