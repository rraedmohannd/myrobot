# Settings of the Smart Campus Robot backend in GUEST mode (beside another project on a shared
# server; docs/DEPLOY_GUEST.md).
#
# install-guest.sh copies this file to /srv/guest/.env (mode 600, never in git) and replaces:
#   __GENERATE__         a new random secret (letters and digits only), a different one each time
#   __ACCESS_CODE__      a new visitor access code xxxx-xxxx-xxxx (shown once in the terminal)
#   __PUBLIC_BASE_URL__  https://pending.invalid (or --public-url); tunnel-url.sh then writes the quick-tunnel address
#   __OPENAI_API_KEY__   the SERVER OpenAI key typed in by Mohannd (hidden input; never echoed or logged)
# Never commit that file, never send it by chat, never copy the PC's .env here.
# After editing it by hand: bash /srv/guest/app/deploy/server/guest/update-guest.sh --restart

# --- Mode ---
APP_ENV=production
LOG_LEVEL=INFO

# --- Image and port (guest mode) ---
# The backend image loaded with load-image.sh. update-guest.sh changes this line.
GUEST_IMAGE=guest-backend:0.6.0
# Ours are 8100-8199 only. 127.0.0.1 = reachable only on the server itself (SSH tunnel, the quick
# tunnel, SSH checks). Never another address without the server owner's OK.
GUEST_BIND=127.0.0.1
GUEST_PORT=8100

# --- Address ---
# Must start with https:// (production check). Written by tunnel-url.sh (the quick-tunnel address);
# used for CORS and the admin QR codes. The pages work on any address (same origin).
PUBLIC_BASE_URL=__PUBLIC_BASE_URL__
CORS_ORIGINS=__PUBLIC_BASE_URL__

# --- Database (container "db", never published on a port) ---
POSTGRES_USER=robot
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=smart_campus

# --- Secrets ---
ADMIN_TOKEN=__GENERATE__
ADMIN_TOKEN_SCRIPTS=false
# The robot (Pi) sends it on /ws/robot; set the same value in the robot's robot.env.
ROBOT_TOKEN=__GENERATE__
# Signs the visitor cookies. Changing it logs every visitor out.
SECRET_KEY=__GENERATE__

# --- Public pages (/robot, /voice, the chat) ---
PUBLIC_PAGES=true
# Give it only to the people at the demo (private message, never in a public place).
SITE_ACCESS_CODE=__ACCESS_CODE__
VISITOR_SESSION_HOURS=12
ADMIN_SESSION_HOURS=12

# --- Cost guard ---
# Paid OpenAI calls per day for the whole server. Over it the robot gives its polite offline reply.
DAILY_PAID_CALL_LIMIT=500
RATE_LIMIT_PAID_PER_MIN=12
RATE_LIMIT_ROBOT_PER_MIN=60
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MIN=15
MEDIA_MAX_MB=50

# --- Web server ---
# X-Forwarded-For/Proto are trusted only from our cloudflared container, which has a fixed address
# on our own network (docker-compose.guest.yml). The published port 127.0.0.1:8100 (SSH checks) is
# not trusted. If Compose reports a subnet overlap (it then changes nothing), pick another unusual
# 10.x.y.0/24 and change all three lines together.
GUEST_SUBNET=10.213.47.0/24
GUEST_TUNNEL_IP=10.213.47.10
FORWARDED_ALLOW_IPS=10.213.47.10
# Keep 1 (the live robot link, rate limiters and login lockout live in the process).
WEB_CONCURRENCY=1

# --- Backups (service "backup"; times are UTC) ---
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
# Media + speech cache tarball only every 7 days (the database every day): disk budget 4 GB.
BACKUP_FILES_EVERY_DAYS=7
CONVERSATION_RETENTION_DAYS=30
LOCAL_TIMEZONE=Asia/Amman

# --- Robot ---
ROBOT_LOCAL_NETS=
ROBOT_OFFLINE_AFTER_S=5
ROBOT_COMMAND_TIMEOUT_S=5

# --- Simulation ---
# Never true on the real server. (true = deterministic FAKE providers, logged as SIMULATED.)
FAKE_PROVIDERS=false

# --- AI providers ---
# A SEPARATE OpenAI key for this server, with a monthly spending limit (made by Mohannd).
OPENAI_API_KEY=__OPENAI_API_KEY__
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=low
LLM_STREAMING=true
EMBEDDING_MODEL=text-embedding-3-small
STT_MODEL=gpt-transcribe
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_REALTIME_MODEL=gpt-realtime-2.1-mini
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
TTS_VOICE=coral
TTS_SPEED=1.12
SPEECH_RATE=1.0
TTS_FIRST_PIECE_WORDS=6
TTS_STREAMING=false
VAD_SILENCE_MS=700
FOLLOW_UP_TIMEOUT_S=10
FAQ_MATCH_THRESHOLD=0.88

# --- Provider time limits, retries, circuit breaker ---
PROVIDER_TIMEOUT_EMBEDDING_S=6
PROVIDER_TIMEOUT_STT_S=12
PROVIDER_TIMEOUT_LLM_FIRST_S=10
PROVIDER_TIMEOUT_LLM_S=25
PROVIDER_TIMEOUT_TTS_S=12
PROVIDER_RETRIES=1
BREAKER_FAILURES=3
BREAKER_OPEN_S=30
FACULTY_PAGE_URL=
